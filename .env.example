# Required to send requests through OpenRouter. Never commit a real key.
OPENROUTER_API_KEY=

# OpenRouter model slug used only for semantic embeddings.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional application attribution headers sent to OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=CacheMind

# Semantic hits require a score at or above this value. It is experimental,
# not a universal optimum.
CACHE_SIMILARITY_THRESHOLD=0.95

# Optional, explicit USD pricing for the chat model used in requests. Leave
# both blank to report avoided tokens without converting them into dollars.
CACHE_INPUT_PRICE_PER_MILLION_TOKENS_USD=
CACHE_OUTPUT_PRICE_PER_MILLION_TOKENS_USD=

# Optional. Estimated embedding price makes the *net* savings figure honest
# (every non-exact lookup pays for one embedding call).
CACHE_EMBEDDING_PRICE_PER_MILLION_TOKENS_USD=

# --- Storage and policy -------------------------------------------------
# "memory" (default, process-local) or "redis" (persistent; needs Redis 8 with its built-in query engine).
CACHE_STORE=memory
REDIS_URL=redis://localhost:6379
CACHE_EMBEDDING_DIMENSIONS=1536
# Memory store only: evict least-recently-used beyond this many entries.
CACHE_MAX_ENTRIES=
CACHE_STABLE_TTL_SECONDS=86400
CACHE_TIME_RELATIVE_TTL_SECONDS=3600
# Bypass the cache above this temperature (blank = no limit).
CACHE_MAX_TEMPERATURE=
# Set to 0 to disable the rule-based TTL/bypass classifier.
CACHE_CLASSIFY_TTL=1
# Set to 0 to disable the ConstraintGuard (similarity alone decides). See README "Threshold analysis".
CACHE_CONSTRAINT_GUARD=1
# Admin endpoints (/v1/cache/invalidate, DELETE /v1/cache) are disabled unless set.
CACHE_ADMIN_TOKEN=
